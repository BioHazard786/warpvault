# ==============================================================================
# Warpvault Configuration
# ==============================================================================

# Server & Network
WARPVAULT_PORT=8080
WARPVAULT_BASE_URL=http://localhost:8080
WARPVAULT_TRUST_PROXY=false

# Local Storage Paths (Bare-metal/local dev; Docker mounts /data)
WARPVAULT_STORAGE_PATH=./data/storage
WARPVAULT_DB_PATH=./data/warpvault.db

# Secret Size Limit (the web UI reads this from /api/info at runtime; includes ~50 bytes of encryption overhead)
WARPVAULT_MAX_SECRET_SIZE_MB=25

# Expiration & Retention
WARPVAULT_DEFAULT_EXPIRY=burn
WARPVAULT_ALLOWED_EXPIRIES=burn,1h,12h,24h,72h
WARPVAULT_GC_INTERVAL=60s

# Optional Authentication: if set, creating secrets requires this token (X-Auth-Token / Bearer). Reading needs none.
WARPVAULT_AUTH_TOKEN=

# Rate Limiting
WARPVAULT_RATE_LIMIT_RPS=10.0
WARPVAULT_RATE_LIMIT_BURST=30

# Logging (format: text | json | logfmt; level: debug | info | warn | error)
WARPVAULT_LOG_FORMAT=text
WARPVAULT_LOG_LEVEL=info
