# Barebone production settings. Copy to .env next to docker-compose.yml:  cp deploy/production.env.example .env
# Everything not listed here has a sensible default (see .env.example for the full list).

# The public address, used in share and delete links. No trailing slash.
WARPVAULT_BASE_URL=https://vault.example.com

# Required behind Caddy/Nginx so rate limiting sees real client IPs (the Caddyfile sample sets X-Real-IP).
WARPVAULT_TRUST_PROXY=true

# Optional: only people with this token can create secrets. Reading a secret never needs one.
# Generate one with: openssl rand -hex 24
# WARPVAULT_AUTH_TOKEN=

# Optional: pin the image version instead of tracking :latest.
# WARPVAULT_VERSION=v1.0.1
