---
import { ThemeToggle } from "@/components/ui/theme-toggle";
import HistorySheet from "@/components/HistorySheet.astro";
import { ShieldCheck } from "@lucide/astro";
---

<header class="sticky top-0 z-50 bg-background/80 backdrop-blur-md border-b border-border/40">
  <div class="max-w-3xl w-full mx-auto flex h-14 items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-foreground font-mono font-bold text-sm tracking-tight hover:opacity-80 transition-opacity">
      <ShieldCheck class="w-4 h-4 text-emerald-500" />
      <span>warpvault</span>
    </a>

    <div class="flex items-center gap-2">
      <HistorySheet />
      <ThemeToggle variant="outline" />
    </div>
  </div>
</header>
