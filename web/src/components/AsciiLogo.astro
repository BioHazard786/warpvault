---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
  delay?: number;
  duration?: number;
}

const { class: className, delay = 100, duration = 450 } = Astro.props;

// Layer 1 & 2: Full ASCII art with double-line borders and contours
const shadowAscii = `██╗    ██╗ █████╗ ██████╗ ██████╗ ██╗   ██╗ █████╗ ██╗   ██╗██╗  ████████╗
██║    ██║██╔══██╗██╔══██╗██╔══██╗██║   ██║██╔══██╗██║   ██║██║  ╚══██╔══╝
██║ █╗ ██║███████║██████╔╝██████╔╝██║   ██║███████║██║   ██║██║     ██║   
██║███╗██║██╔══██║██╔══██╗██╔═══╝ ╚██╗ ██╔╝██╔══██║██║   ██║██║     ██║   
╚███╔███╔╝██║  ██║██║  ██║██║      ╚████╔╝ ██║  ██║╚██████╔╝███████╗██║   
 ╚══╝╚══╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝       ╚═══╝  ╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝   `;

// Layer 3: Solid block foreground
const solidAscii = `██     ██  █████  ██████  ██████  ██     ██  █████  ██     ██ ██   ████████ 
██     ██ ██   ██ ██   ██ ██   ██ ██     ██ ██   ██ ██     ██ ██      ██    
██  █  ██ ███████ ██████  ██████  ██     ██ ███████ ██     ██ ██      ██    
██ ███ ██ ██   ██ ██   ██ ██       ██   ██  ██   ██ ██     ██ ██      ██    
 ███ ███  ██   ██ ██   ██ ██        █████   ██   ██  ███████  ███████ ██    
                                                                            `;
---

<div
  class={cn(
    "ascii-logo-container relative w-full flex items-start justify-start overflow-hidden",
    className,
  )}
  data-solid={solidAscii}
  data-delay={delay}
  data-duration={duration}
>
  <div class="relative max-w-full overflow-x-auto sm:overflow-visible py-1">
    <!-- Layer 1: Sizer (maintains strict dimensions and prevents layout shift) -->
    <pre
      aria-hidden="true"
      class="invisible text-[7.5px] sm:text-[9.5px] md:text-[11.5px] lg:text-[13px] tracking-[-1px] leading-[125%] select-none whitespace-pre font-mono"
    >{shadowAscii}</pre>

    <!-- Layer 2: Outline contour shadow layer (ghost background) -->
    <pre
      aria-hidden="true"
      class="absolute top-1 left-0 text-[7.5px] sm:text-[9.5px] md:text-[11.5px] lg:text-[13px] tracking-[-1px] leading-[125%] text-muted-foreground select-none whitespace-pre font-mono opacity-30 dark:opacity-20"
    >{shadowAscii}</pre>

    <!-- Layer 3: Solid block foreground (neon emerald / vault glow) -->
    <pre
      class="ascii-solid absolute top-1 left-0 text-[7.5px] sm:text-[9.5px] md:text-[11.5px] lg:text-[13px] tracking-[-1px] leading-[125%] text-emerald-500 select-none whitespace-pre font-mono font-bold"
    >{solidAscii}</pre>
  </div>
</div>
