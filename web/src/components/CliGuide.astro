---
import { Terminal, Copy, Check } from "@lucide/astro";

const cliSnippet = `# Send text via terminal pipe (burn-on-read by default)
echo "sk_live_999888777" | warpvault send

# Send a private file (custom 12h expiry)
warpvault send -f ~/.ssh/id_rsa --expiry 12h

# Fetch and decrypt directly to stdout
warpvault get "https://vault.domain.com/v/a8X2mP9z#f8c3e210..."`;

const opensslSnippet = `# 1. Encrypt locally and upload via curl:
PASS=$(openssl rand -hex 16)
ID=$(echo "my_api_key" | openssl enc -aes-256-cbc -pbkdf2 -salt -pass pass:"$PASS" | \\
    curl -s -X POST -T - "https://vault.domain.com/api/vault?burn=true" | jq -r .id)
echo "https://vault.domain.com/v/\${ID}#\${PASS}"

# 2. Fetch and decrypt via curl:
curl -s "https://vault.domain.com/api/vault/a8X2mP9z" | \\
    openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"f8c3e210..."`;

const opensslCopySnippet = `PASS=$(openssl rand -hex 16)
ID=$(echo "my_secret" | openssl enc -aes-256-cbc -pbkdf2 -salt -pass pass:"$PASS" | curl -s -X POST -T - "https://vault.domain.com/api/vault?burn=true" | jq -r .id)
echo "https://vault.domain.com/v/\${ID}#\${PASS}"`;
---

<div class="rounded-xl border border-border/60 bg-card/40 p-5 sm:p-6 flex flex-col gap-4">
  <div class="flex items-center justify-between border-b border-border/40 pb-3">
    <div class="flex items-center gap-2 text-xs font-mono font-medium text-foreground">
      <Terminal class="w-4 h-4 text-emerald-400" />
      <span>Terminal Native Usage</span>
    </div>

    <!-- Sub-tab switchers -->
    <div class="flex items-center gap-1 bg-muted/40 p-1 rounded-lg border border-border/40 text-[11px] font-mono">
      <button
        type="button"
        id="guide-tab-cli"
        class="guide-tab active px-2.5 py-1 rounded bg-background text-foreground shadow-xs cursor-pointer font-medium"
      >
        CLI Binary
      </button>
      <button
        type="button"
        id="guide-tab-openssl"
        class="guide-tab px-2.5 py-1 rounded text-muted-foreground hover:text-foreground cursor-pointer font-medium"
      >
        OpenSSL + curl
      </button>
    </div>
  </div>

  <!-- CLI Guide Panel -->
  <div id="guide-panel-cli" class="flex flex-col gap-3 font-mono text-xs">
    <p class="text-xs text-muted-foreground font-sans">
      Using the standalone <code class="text-emerald-400 font-mono">warpvault</code> CLI tool:
    </p>

    <div class="relative group">
      <pre class="bg-muted/30 p-3.5 rounded-lg border border-border/50 text-foreground overflow-x-auto leading-relaxed select-all">{cliSnippet}</pre>
      <button
        type="button"
        class="copy-snippet-btn absolute top-2.5 right-2.5 p-1.5 rounded-md bg-muted/60 hover:bg-muted text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
        data-snippet='echo "sk_live_999888777" | warpvault send'
      >
        <Copy class="w-3.5 h-3.5 copy-icon" />
        <Check class="w-3.5 h-3.5 check-icon hidden text-emerald-400" />
      </button>
    </div>
  </div>

  <!-- OpenSSL Guide Panel -->
  <div id="guide-panel-openssl" class="hidden flex-col gap-3 font-mono text-xs">
    <p class="text-xs text-muted-foreground font-sans">
      Zero CLI required — pure standard <code class="text-emerald-400 font-mono">openssl</code> and <code class="text-emerald-400 font-mono">curl</code> piping:
    </p>

    <div class="relative group">
      <pre class="bg-muted/30 p-3.5 rounded-lg border border-border/50 text-foreground overflow-x-auto leading-relaxed select-all">{opensslSnippet}</pre>
      <button
        type="button"
        class="copy-snippet-btn absolute top-2.5 right-2.5 p-1.5 rounded-md bg-muted/60 hover:bg-muted text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
        data-snippet={opensslCopySnippet}
      >
        <Copy class="w-3.5 h-3.5 copy-icon" />
        <Check class="w-3.5 h-3.5 check-icon hidden text-emerald-400" />
      </button>
    </div>
  </div>
</div>

<script>
  const tabCli = document.getElementById("guide-tab-cli");
  const tabOpenSSL = document.getElementById("guide-tab-openssl");
  const panelCli = document.getElementById("guide-panel-cli");
  const panelOpenSSL = document.getElementById("guide-panel-openssl");

  tabCli?.addEventListener("click", () => {
    tabCli.classList.add("bg-background", "text-foreground", "shadow-xs");
    tabCli.classList.remove("text-muted-foreground");
    tabOpenSSL?.classList.remove("bg-background", "text-foreground", "shadow-xs");
    tabOpenSSL?.classList.add("text-muted-foreground");
    panelCli?.classList.remove("hidden");
    panelOpenSSL?.classList.add("hidden");
  });

  tabOpenSSL?.addEventListener("click", () => {
    tabOpenSSL.classList.add("bg-background", "text-foreground", "shadow-xs");
    tabOpenSSL.classList.remove("text-muted-foreground");
    tabCli?.classList.remove("bg-background", "text-foreground", "shadow-xs");
    tabCli?.classList.add("text-muted-foreground");
    panelOpenSSL?.classList.remove("hidden");
    panelCli?.classList.add("hidden");
  });

  document.querySelectorAll<HTMLButtonElement>(".copy-snippet-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const snip = btn.dataset.snippet;
      if (!snip) return;
      await navigator.clipboard.writeText(snip);
      const copyIcon = btn.querySelector(".copy-icon");
      const checkIcon = btn.querySelector(".check-icon");
      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
      }, 1500);
    });
  });
</script>
