---
import { Button } from "@/components/ui/button";
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetDescription,
  SheetTrigger,
  SheetFooter,
} from "@/components/ui/sheet";
import {
  RotateCcwClock,
  Trash2,
  Copy,
  Check,
  Flame,
  Clock,
  ExternalLink,
  ShieldAlert,
} from "@lucide/astro";
---

<Sheet id="history-sheet">
  <SheetTrigger id="toggle-history-btn" variant="outline" size="icon-sm" title="Vault History">
    <RotateCcwClock class="w-4 h-4 text-muted-foreground" />
  </SheetTrigger>

  <SheetContent side="right" class="w-full sm:max-w-md flex flex-col p-0">
    <SheetHeader class="p-6 border-b border-border/40">
      <SheetTitle class="flex items-center gap-2">
        <RotateCcwClock class="w-4 h-4 text-emerald-500" />
        Vault History
      </SheetTitle>
      <SheetDescription>
        Secrets created from this browser. Stored strictly in your local device storage.
      </SheetDescription>
    </SheetHeader>

    <div id="history-items-container" class="flex-1 overflow-y-auto p-4 space-y-3">
      <!-- Injected by client script -->
    </div>

    <!-- Empty State -->
    <div id="history-empty" class="hidden flex-1 flex flex-col items-center justify-center p-8 text-center text-muted-foreground">
      <ShieldAlert class="w-10 h-10 mb-3 text-muted-foreground/40" />
      <p class="text-sm font-medium">No secrets created yet</p>
      <p class="text-xs text-muted-foreground/60 mt-1">Secrets you generate will appear here so you can re-copy or delete them early.</p>
    </div>

    <SheetFooter class="p-4 border-t border-border/40 bg-muted/20 flex justify-between items-center">
      <button
        id="clear-history-btn"
        class="text-xs text-muted-foreground hover:text-destructive flex items-center gap-1.5 transition-colors cursor-pointer"
      >
        <Trash2 class="w-3.5 h-3.5" />
        Clear History
      </button>
      <span class="text-[11px] text-muted-foreground/60">Local storage only</span>
    </SheetFooter>
  </SheetContent>
</Sheet>

<script>
  interface HistoryItem {
    id: string;
    shareUrl: string;
    isBurn: boolean;
    createdAt: string;
    deleteUrl: string;
    deleteToken: string;
  }

  function getHistory(): HistoryItem[] {
    try {
      const raw = localStorage.getItem("warpvault_history");
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }

  function renderHistory() {
    const items = getHistory();
    const container = document.getElementById("history-items-container");
    const empty = document.getElementById("history-empty");
    if (!container || !empty) return;

    if (items.length === 0) {
      container.innerHTML = "";
      empty.classList.remove("hidden");
      return;
    }

    empty.classList.add("hidden");
    container.innerHTML = items
      .map(
        (item) => `
      <div class="p-3.5 rounded-lg border border-border/60 bg-card/60 flex flex-col gap-2 relative group hover:border-border transition-colors">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5">
            ${
              item.isBurn
                ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-red-500/10 text-red-400 border border-red-500/20">
                     <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                     Burn on read
                   </span>`
                : `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                     Timed Vault
                   </span>`
            }
            <span class="text-[11px] text-muted-foreground font-mono">ID: ${item.id}</span>
          </div>
          <span class="text-[10px] text-muted-foreground">${new Date(item.createdAt).toLocaleDateString()}</span>
        </div>

        <div class="flex items-center gap-1.5 bg-muted/30 rounded p-1.5 font-mono text-xs overflow-hidden">
          <input
            type="text"
            readonly
            value="${item.shareUrl}"
            class="bg-transparent text-foreground flex-1 outline-none truncate select-all text-[11px]"
          />
          <button
            data-copy-url="${item.shareUrl}"
            class="copy-btn p-1 rounded hover:bg-muted text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
            title="Copy link"
          >
            <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
        </div>

        <div class="flex items-center justify-between pt-1">
          <a
            href="${item.shareUrl}"
            target="_blank"
            class="text-[11px] text-emerald-400/80 hover:text-emerald-400 flex items-center gap-1 hover:underline"
          >
            Open Secret
            <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          </a>
          <button
            data-delete-id="${item.id}"
            data-delete-token="${item.deleteToken}"
            class="delete-item-btn text-[11px] text-muted-foreground hover:text-destructive flex items-center gap-1 transition-colors cursor-pointer"
          >
            Destroy Early
          </button>
        </div>
      </div>
    `
      )
      .join("");

    // Bind copy buttons
    container.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.dataset.copyUrl;
        if (!url) return;
        await navigator.clipboard.writeText(url);
        const copyIcon = btn.querySelector(".copy-icon");
        const checkIcon = btn.querySelector(".check-icon");
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
        }, 1500);
      });
    });

    // Bind delete buttons
    container.querySelectorAll<HTMLButtonElement>(".delete-item-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.deleteId;
        const token = btn.dataset.deleteToken;
        if (!id || !token) return;

        if (confirm("Permanently destroy this secret right now?")) {
          try {
            await fetch(`/api/vault/${id}`, {
              method: "DELETE",
              headers: { "X-Delete-Token": token },
            });
          } catch {
            // Proceed to clean locally regardless
          }
          const updated = getHistory().filter((i) => i.id !== id);
          localStorage.setItem("warpvault_history", JSON.stringify(updated));
          renderHistory();
        }
      });
    });
  }

  // Clear all history
  document.getElementById("clear-history-btn")?.addEventListener("click", () => {
    if (confirm("Clear local vault history? (Secrets on server will still follow their expiration timers)")) {
      localStorage.removeItem("warpvault_history");
      renderHistory();
    }
  });

  // Re-render when sheet opens
  document.getElementById("toggle-history-btn")?.addEventListener("click", () => {
    renderHistory();
  });

  // Listen for custom event when new secret is created
  window.addEventListener("vault-secret-created", () => {
    renderHistory();
  });

  // Initial render
  renderHistory();
</script>
