---
import {
  Lock,
  Flame,
  Clock,
  KeyRound,
  FileUp,
  FileText,
  Copy,
  Check,
  QrCode,
  Trash2,
  ExternalLink,
  ShieldCheck,
  Terminal,
  X,
} from "@lucide/astro";

interface Props {
  maxSecretSizeMB?: number;
}

const { maxSecretSizeMB = 25 } = Astro.props;
---

<div class="w-full flex flex-col gap-6">
  <!-- Main Secret Creation Card -->
  <div id="vault-card" class="rounded-xl border border-border/70 bg-card/60 backdrop-blur-sm p-5 sm:p-7 shadow-2xl relative overflow-hidden">
    <!-- Cyber ambient gradient accent -->
    <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Mode Switcher Tabs -->
    <div class="flex items-center justify-between border-b border-border/40 pb-4 mb-5">
      <div class="flex items-center gap-1.5 p-1 bg-muted/40 rounded-lg border border-border/40">
        <button
          type="button"
          id="tab-text"
          class="tab-btn active px-3.5 py-1.5 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 cursor-pointer bg-background text-foreground shadow-sm"
        >
          <FileText class="w-3.5 h-3.5 text-emerald-400" />
          Text / Token
        </button>
        <button
          type="button"
          id="tab-file"
          class="tab-btn px-3.5 py-1.5 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 cursor-pointer text-muted-foreground hover:text-foreground"
        >
          <FileUp class="w-3.5 h-3.5" />
          File Attachment
        </button>
      </div>

      <div class="text-[11px] font-mono text-muted-foreground flex items-center gap-1">
        <ShieldCheck class="w-3.5 h-3.5 text-emerald-500" />
        <span class="hidden sm:inline">Zero-Knowledge</span> AES-256
      </div>
    </div>

    <!-- Mode 1: Text Input -->
    <div id="panel-text" class="flex flex-col gap-2">
      <div class="relative rounded-lg border border-input bg-background/50 focus-within:border-emerald-500/50 focus-within:ring-1 focus-within:ring-emerald-500/20 transition-all">
        <textarea
          id="secret-text"
          rows="8"
          placeholder="Paste API keys, database credentials, .env files, private keys, or confidential notes here..."
          class="w-full p-4 bg-transparent outline-none resize-y text-xs sm:text-sm font-mono leading-relaxed placeholder:text-muted-foreground/50 text-foreground"
        ></textarea>
        <div class="flex items-center justify-between px-3 py-2 border-t border-border/30 bg-muted/10 text-[11px] font-mono text-muted-foreground">
          <span id="char-count">0 characters</span>
          <span id="line-count">0 lines</span>
        </div>
      </div>
    </div>

    <!-- Mode 2: File Dropzone -->
    <div id="panel-file" class="hidden flex-col gap-3">
      <div
        id="dropzone"
        class="border-2 border-dashed border-border/70 hover:border-emerald-500/50 rounded-xl p-8 flex flex-col items-center justify-center gap-3 transition-colors bg-muted/10 cursor-pointer"
      >
        <input type="file" id="file-input" class="hidden" />
        <div class="w-12 h-12 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-400">
          <FileUp class="w-6 h-6" />
        </div>
        <div class="text-center">
          <p class="text-sm font-medium text-foreground">Click to upload or drag & drop</p>
          <p class="text-xs text-muted-foreground mt-0.5">Certificates (.pem, .key), SSH keys, archives, .env up to {maxSecretSizeMB}MB</p>
        </div>
      </div>

      <!-- Selected File Preview -->
      <div id="file-preview" class="hidden items-center justify-between p-3 rounded-lg border border-border/60 bg-muted/30">
        <div class="flex items-center gap-2.5 overflow-hidden">
          <FileText class="w-5 h-5 text-emerald-400 shrink-0" />
          <div class="flex flex-col truncate">
            <span id="file-name" class="text-xs font-mono font-medium truncate text-foreground"></span>
            <span id="file-size" class="text-[10px] text-muted-foreground"></span>
          </div>
        </div>
        <button type="button" id="remove-file-btn" class="p-1 text-muted-foreground hover:text-destructive cursor-pointer">
          <X class="w-4 h-4" />
        </button>
      </div>
    </div>

    <!-- Expiration & Security Settings Bar -->
    <div class="mt-5 pt-5 border-t border-border/40 flex flex-col gap-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <label class="text-xs font-medium text-muted-foreground flex items-center gap-1.5">
          <Clock class="w-3.5 h-3.5" />
          Self-Destruction Lifecycle:
        </label>

        <!-- Expiry pills -->
        <div class="flex items-center gap-1.5 flex-wrap">
          <button
            type="button"
            data-expiry="burn"
            class="expiry-pill active px-3 py-1.5 rounded-lg text-xs font-medium transition-all flex items-center gap-1 cursor-pointer bg-red-500/10 text-red-400 border border-red-500/30"
          >
            <Flame class="w-3 h-3" />
            Burn on read
          </button>
          <button
            type="button"
            data-expiry="1h"
            class="expiry-pill px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer bg-muted/40 text-muted-foreground border border-border/40 hover:text-foreground"
          >
            1 Hour
          </button>
          <button
            type="button"
            data-expiry="12h"
            class="expiry-pill px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer bg-muted/40 text-muted-foreground border border-border/40 hover:text-foreground"
          >
            12 Hours
          </button>
          <button
            type="button"
            data-expiry="24h"
            class="expiry-pill px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer bg-muted/40 text-muted-foreground border border-border/40 hover:text-foreground"
          >
            24 Hours
          </button>
          <button
            type="button"
            data-expiry="72h"
            class="expiry-pill px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer bg-muted/40 text-muted-foreground border border-border/40 hover:text-foreground"
          >
            72 Hours
          </button>
        </div>
      </div>

      <!-- Optional Custom Passphrase toggle -->
      <div class="flex flex-col gap-2">
        <button
          type="button"
          id="toggle-password-btn"
          class="text-xs text-muted-foreground hover:text-foreground flex items-center gap-1.5 self-start cursor-pointer transition-colors"
        >
          <KeyRound class="w-3.5 h-3.5 text-emerald-400" />
          <span>Add Custom Passphrase Protection (Optional)</span>
        </button>

        <div id="password-wrapper" class="hidden mt-1">
          <input
            type="password"
            id="custom-password"
            placeholder="Enter an optional passphrase (recipient must enter this to decrypt)"
            class="w-full px-3.5 py-2 rounded-lg border border-input bg-background/60 text-xs font-mono outline-none focus:border-emerald-500/50"
          />
        </div>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="mt-6">
      <button
        type="button"
        id="submit-secret-btn"
        class="w-full py-3 px-4 rounded-xl font-medium text-sm transition-all flex items-center justify-center gap-2 cursor-pointer bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-950/20 active:scale-[0.99]"
      >
        <Lock class="w-4 h-4" />
        <span id="submit-btn-text">Encrypt & Create Secret Link</span>
      </button>
    </div>
  </div>

  <!-- Result Modal / Card (Shown after encryption) -->
  <div id="result-card" class="hidden rounded-xl border border-emerald-500/40 bg-card/80 backdrop-blur-md p-6 sm:p-7 shadow-2xl relative">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-400 shrink-0">
          <ShieldCheck class="w-4 h-4" />
        </div>
        <div>
          <h3 class="text-sm font-semibold text-foreground">Secret Encrypted & Stored</h3>
          <p id="result-badge-text" class="text-xs text-muted-foreground">Self-destructs immediately after reading</p>
        </div>
      </div>

      <button type="button" id="close-result-btn" class="p-1 rounded text-muted-foreground hover:text-foreground cursor-pointer">
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Share Link Box -->
    <div class="flex flex-col gap-2">
      <label class="text-xs font-medium text-muted-foreground">Shareable Decryption Link:</label>
      <div class="flex items-center gap-2 bg-muted/40 border border-border/80 rounded-lg p-2 font-mono text-xs sm:text-sm">
        <input
          type="text"
          id="result-share-link"
          readonly
          class="bg-transparent flex-1 text-foreground outline-none select-all truncate font-mono text-xs"
        />
        <button
          type="button"
          id="copy-result-btn"
          class="px-3 py-1.5 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer shrink-0"
        >
          <Copy class="w-3.5 h-3.5" id="copy-btn-icon" />
          <Check class="w-3.5 h-3.5 hidden text-white" id="copy-btn-check" />
          <span id="copy-btn-text">Copy Link</span>
        </button>
      </div>
      <p class="text-[11px] text-muted-foreground/70">
        ⚠️ The key is in the <span class="font-mono text-emerald-400">#hash</span> fragment. Never share without the hash!
      </p>
    </div>

    <!-- Actions Bar (QR Code toggle, Delete link, New Secret) -->
    <div class="mt-5 pt-4 border-t border-border/40 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="toggle-qr-btn"
          class="text-muted-foreground hover:text-foreground flex items-center gap-1 transition-colors cursor-pointer"
        >
          <QrCode class="w-3.5 h-3.5 text-emerald-400" />
          <span id="qr-toggle-label">Show QR Code</span>
        </button>

        <a
          id="result-open-link"
          href="#"
          target="_blank"
          class="text-muted-foreground hover:text-emerald-400 flex items-center gap-1 transition-colors"
        >
          <ExternalLink class="w-3.5 h-3.5" />
          Test Link
        </a>
      </div>

      <button
        type="button"
        id="result-delete-btn"
        class="text-muted-foreground hover:text-destructive flex items-center gap-1 transition-colors cursor-pointer"
      >
        <Trash2 class="w-3.5 h-3.5" />
        Destroy Now
      </button>
    </div>

    <!-- QR Code Container (Collapsible) -->
    <div id="qr-container" class="hidden mt-4 pt-4 border-t border-border/40 flex flex-col items-center justify-center gap-2">
      <canvas id="qr-canvas" class="rounded-lg border border-border p-2 bg-white"></canvas>
      <p class="text-[11px] text-muted-foreground">Scan with a mobile camera to decrypt on device</p>
    </div>

    <!-- CLI Snippet -->
    <div class="mt-4 pt-4 border-t border-border/40 flex flex-col gap-1.5">
      <span class="text-[11px] font-mono text-muted-foreground flex items-center gap-1">
        <Terminal class="w-3 h-3 text-emerald-400" />
        Download via CLI:
      </span>
      <div class="p-2 rounded bg-muted/30 border border-border/40 font-mono text-[11px] text-muted-foreground flex items-center justify-between select-all">
        <code id="cli-snippet" class="truncate"></code>
      </div>
    </div>
  </div>
</div>

<script>
  import { encryptPayload, packFile } from "@/lib/crypto";
  import QRCode from "qrcode";

  // State
  let activeTab: "text" | "file" = "text";
  let activeExpiry = "burn";
  let selectedFile: File | null = null;
  let currentDeleteToken = "";
  let currentSecretId = "";

  // DOM Elements
  const tabText = document.getElementById("tab-text");
  const tabFile = document.getElementById("tab-file");
  const panelText = document.getElementById("panel-text");
  const panelFile = document.getElementById("panel-file");
  const secretText = document.getElementById("secret-text") as HTMLTextAreaElement;
  const charCount = document.getElementById("char-count");
  const lineCount = document.getElementById("line-count");
  const dropzone = document.getElementById("dropzone");
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const filePreview = document.getElementById("file-preview");
  const fileName = document.getElementById("file-name");
  const fileSize = document.getElementById("file-size");
  const removeFileBtn = document.getElementById("remove-file-btn");
  const togglePassBtn = document.getElementById("toggle-password-btn");
  const passWrapper = document.getElementById("password-wrapper");
  const customPassword = document.getElementById("custom-password") as HTMLInputElement;
  const submitBtn = document.getElementById("submit-secret-btn") as HTMLButtonElement;
  const submitBtnText = document.getElementById("submit-btn-text");

  const vaultCard = document.getElementById("vault-card");
  const resultCard = document.getElementById("result-card");
  const resultShareLink = document.getElementById("result-share-link") as HTMLInputElement;
  const resultBadgeText = document.getElementById("result-badge-text");
  const copyResultBtn = document.getElementById("copy-result-btn");
  const copyBtnIcon = document.getElementById("copy-btn-icon");
  const copyBtnCheck = document.getElementById("copy-btn-check");
  const copyBtnText = document.getElementById("copy-btn-text");
  const toggleQrBtn = document.getElementById("toggle-qr-btn");
  const qrContainer = document.getElementById("qr-container");
  const qrCanvas = document.getElementById("qr-canvas") as HTMLCanvasElement;
  const qrToggleLabel = document.getElementById("qr-toggle-label");
  const resultOpenLink = document.getElementById("result-open-link") as HTMLAnchorElement;
  const resultDeleteBtn = document.getElementById("result-delete-btn");
  const closeResultBtn = document.getElementById("close-result-btn");
  const cliSnippet = document.getElementById("cli-snippet");

  // Tab Switching
  tabText?.addEventListener("click", () => {
    activeTab = "text";
    tabText.classList.add("bg-background", "text-foreground", "shadow-sm");
    tabText.classList.remove("text-muted-foreground");
    tabFile?.classList.remove("bg-background", "text-foreground", "shadow-sm");
    tabFile?.classList.add("text-muted-foreground");
    panelText?.classList.remove("hidden");
    panelFile?.classList.add("hidden");
  });

  tabFile?.addEventListener("click", () => {
    activeTab = "file";
    tabFile.classList.add("bg-background", "text-foreground", "shadow-sm");
    tabFile.classList.remove("text-muted-foreground");
    tabText?.classList.remove("bg-background", "text-foreground", "shadow-sm");
    tabText?.classList.add("text-muted-foreground");
    panelFile?.classList.remove("hidden");
    panelText?.classList.add("hidden");
  });

  // Textarea Counters
  secretText?.addEventListener("input", () => {
    const val = secretText.value;
    if (charCount) charCount.textContent = `${val.length} characters`;
    if (lineCount) {
      const lines = val ? val.split("\n").length : 0;
      lineCount.textContent = `${lines} line${lines === 1 ? "" : "s"}`;
    }
  });

  // Expiry Pills
  document.querySelectorAll<HTMLButtonElement>(".expiry-pill").forEach((pill) => {
    pill.addEventListener("click", () => {
      document.querySelectorAll(".expiry-pill").forEach((p) => {
        p.classList.remove("active", "bg-red-500/10", "text-red-400", "border-red-500/30", "bg-emerald-500/10", "text-emerald-400", "border-emerald-500/30");
        p.classList.add("bg-muted/40", "text-muted-foreground", "border-border/40");
      });

      const exp = pill.dataset.expiry || "burn";
      activeExpiry = exp;

      pill.classList.remove("bg-muted/40", "text-muted-foreground", "border-border/40");
      if (exp === "burn") {
        pill.classList.add("active", "bg-red-500/10", "text-red-400", "border-red-500/30");
      } else {
        pill.classList.add("active", "bg-emerald-500/10", "text-emerald-400", "border-emerald-500/30");
      }
    });
  });

  // Password toggle
  togglePassBtn?.addEventListener("click", () => {
    passWrapper?.classList.toggle("hidden");
    if (!passWrapper?.classList.contains("hidden")) {
      customPassword?.focus();
    }
  });

  // File Dropzone Handling
  dropzone?.addEventListener("click", () => fileInput?.click());
  dropzone?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("border-emerald-500", "bg-emerald-500/5");
  });
  dropzone?.addEventListener("dragleave", () => {
    dropzone.classList.remove("border-emerald-500", "bg-emerald-500/5");
  });
  dropzone?.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove("border-emerald-500", "bg-emerald-500/5");
    if (e.dataTransfer?.files.length) {
      handleSelectedFile(e.dataTransfer.files[0]);
    }
  });
  fileInput?.addEventListener("change", () => {
    if (fileInput.files?.length) {
      handleSelectedFile(fileInput.files[0]);
    }
  });

  function handleSelectedFile(file: File) {
    selectedFile = file;
    if (fileName) fileName.textContent = file.name;
    if (fileSize) {
      const kb = (file.size / 1024).toFixed(1);
      fileSize.textContent = `${kb} KB`;
    }
    dropzone?.classList.add("hidden");
    filePreview?.classList.remove("hidden");
    filePreview?.classList.add("flex");
  }

  removeFileBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    selectedFile = null;
    fileInput.value = "";
    filePreview?.classList.add("hidden");
    filePreview?.classList.remove("flex");
    dropzone?.classList.remove("hidden");
  });

  // Submit & Encrypt
  submitBtn?.addEventListener("click", async () => {
    let payloadBytes: Uint8Array;

    if (activeTab === "text") {
      const text = secretText?.value?.trim();
      if (!text) {
        alert("Please enter a secret before submitting.");
        secretText?.focus();
        return;
      }
      payloadBytes = new TextEncoder().encode(text);
    } else {
      if (!selectedFile) {
        alert("Please select a file to upload.");
        return;
      }
      const arrayBuf = await selectedFile.arrayBuffer();
      payloadBytes = packFile(selectedFile.name, new Uint8Array(arrayBuf));
    }

    const optionalPass = customPassword?.value?.trim() || undefined;

    // Loading State
    submitBtn.disabled = true;
    if (submitBtnText) submitBtnText.textContent = "Encrypting client-side...";

    try {
      // 1. Client-Side Encryption
      const { ciphertext, key } = await encryptPayload(payloadBytes, optionalPass);

      if (submitBtnText) submitBtnText.textContent = "Storing in vault...";

      // 2. Post ciphertext to server
      const isBurn = activeExpiry === "burn";
      const query = new URLSearchParams();
      if (isBurn) {
        query.set("burn", "true");
      } else {
        query.set("time", activeExpiry);
      }

      const res = await fetch(`/api/vault?${query.toString()}`, {
        method: "POST",
        headers: {
          "Content-Type": "application/octet-stream",
          "Accept": "application/json",
        },
        body: ciphertext as unknown as BodyInit,
      });

      if (!res.ok) {
        const errText = await res.text();
        throw new Error(`Upload failed: ${errText}`);
      }

      const data = await res.json();
      currentSecretId = data.id;
      currentDeleteToken = data.delete_token;

      // Construct client share link with hash fragment
      const origin = window.location.origin;
      const shareUrl = `${origin}/v/${data.id}#${key}`;

      // 3. Save to localStorage history
      try {
        const history = JSON.parse(localStorage.getItem("warpvault_history") || "[]");
        history.unshift({
          id: data.id,
          shareUrl,
          isBurn: data.is_burn_on_read,
          createdAt: data.created_at,
          deleteUrl: data.delete_url,
          deleteToken: data.delete_token,
        });
        localStorage.setItem("warpvault_history", JSON.stringify(history.slice(0, 50)));
        window.dispatchEvent(new CustomEvent("vault-secret-created"));
      } catch {
        // LocalStorage fallback
      }

      // 4. Render Result Card
      if (resultShareLink) resultShareLink.value = shareUrl;
      if (resultOpenLink) resultOpenLink.href = shareUrl;
      if (resultBadgeText) {
        resultBadgeText.textContent = isBurn
          ? "Single-use Burn: will be destroyed the second it is revealed."
          : `Expires automatically on ${new Date(data.expires_at).toLocaleString()}`;
      }
      if (cliSnippet) {
        cliSnippet.textContent = `warpvault get "${shareUrl}"`;
      }

      // Generate QR Code
      if (qrCanvas) {
        QRCode.toCanvas(qrCanvas, shareUrl, {
          width: 180,
          margin: 1,
          color: { dark: "#000000", light: "#ffffff" },
        });
      }

      // Reset Form & Show Result
      if (secretText) secretText.value = "";
      if (charCount) charCount.textContent = "0 characters";
      if (lineCount) lineCount.textContent = "0 lines";
      if (selectedFile) removeFileBtn?.click();

      resultCard?.classList.remove("hidden");
      resultCard?.scrollIntoView({ behavior: "smooth" });
    } catch (err: any) {
      alert(`Error creating secret: ${err.message}`);
    } finally {
      submitBtn.disabled = false;
      if (submitBtnText) submitBtnText.textContent = "Encrypt & Create Secret Link";
    }
  });

  // Copy Result Link
  copyResultBtn?.addEventListener("click", async () => {
    if (!resultShareLink?.value) return;
    await navigator.clipboard.writeText(resultShareLink.value);
    copyBtnIcon?.classList.add("hidden");
    copyBtnCheck?.classList.remove("hidden");
    if (copyBtnText) copyBtnText.textContent = "Copied!";
    setTimeout(() => {
      copyBtnIcon?.classList.remove("hidden");
      copyBtnCheck?.classList.add("hidden");
      if (copyBtnText) copyBtnText.textContent = "Copy Link";
    }, 2000);
  });

  // Toggle QR Code
  toggleQrBtn?.addEventListener("click", () => {
    qrContainer?.classList.toggle("hidden");
    const isHidden = qrContainer?.classList.contains("hidden");
    if (qrToggleLabel) {
      qrToggleLabel.textContent = isHidden ? "Show QR Code" : "Hide QR Code";
    }
  });

  // Destroy Result Early
  resultDeleteBtn?.addEventListener("click", async () => {
    if (!currentSecretId || !currentDeleteToken) return;
    if (confirm("Permanently destroy this secret right now?")) {
      try {
        await fetch(`/api/vault/${currentSecretId}`, {
          method: "DELETE",
          headers: { "X-Delete-Token": currentDeleteToken },
        });
        alert("Secret has been permanently deleted from the server.");
        resultCard?.classList.add("hidden");
      } catch (err: any) {
        alert("Failed to delete secret: " + err.message);
      }
    }
  });

  closeResultBtn?.addEventListener("click", () => {
    resultCard?.classList.add("hidden");
  });
</script>
