---
import Layout from "@/layouts/Layout.astro";
import { AlertTriangle, Home } from "@lucide/astro";
---

<Layout
  title="500 — Internal Server Error — Warpvault"
  description="An internal server error occurred."
>
  <div class="flex flex-1 items-center justify-center p-4 min-h-[calc(100vh-4rem)]">
    <div class="max-w-md w-full rounded-2xl border border-border/70 bg-card/70 p-8 text-center flex flex-col items-center">
      <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-4">
        <AlertTriangle class="w-7 h-7" />
      </div>
      <h1 class="text-xl font-bold text-foreground">500 Server Error</h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1 max-w-xs">
        An unexpected error occurred while processing your request. Please try again in a few moments.
      </p>
      <a href="/" class="mt-6 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-medium flex items-center gap-1.5 transition-colors">
        <Home class="w-3.5 h-3.5" />
        Return to Warpvault
      </a>
    </div>
  </div>
</Layout>
