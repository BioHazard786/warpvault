---
import Layout from "@/layouts/Layout.astro";
import { Flame, Home } from "@lucide/astro";
---

<Layout
  title="410 — Secret Burned & Destroyed — Warpvault"
  description="This single-use secret was configured to burn after reading and has already been permanently deleted."
>
  <div class="flex flex-1 items-center justify-center p-4 min-h-[calc(100vh-4rem)]">
    <div class="max-w-md w-full rounded-2xl border border-red-500/30 bg-card/70 p-8 text-center flex flex-col items-center shadow-2xl">
      <div class="w-14 h-14 rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 mb-4">
        <Flame class="w-7 h-7" />
      </div>
      <h1 class="text-xl font-bold text-foreground">Secret Burned & Destroyed</h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1 max-w-xs leading-relaxed">
        This secret was configured with <strong>Burn-After-Reading</strong> and
        has already been revealed or its expiration timer has elapsed. No copies remain.
      </p>
      <a href="/" class="mt-6 px-4 py-2 rounded-xl bg-muted/60 hover:bg-muted text-foreground border border-border/60 text-xs font-medium flex items-center gap-1.5 transition-colors">
        <Home class="w-3.5 h-3.5" />
        Create a New Secret
      </a>
    </div>
  </div>
</Layout>
